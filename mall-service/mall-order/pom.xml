<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mallcloud</groupId>
        <artifactId>mall-service</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>mall-order</artifactId>
    <name>mall-order</name>
    <description>订单服务：交易核心。唯一使用 Seata 全局事务的服务（下单时扣库存+锁券）。
        支付结果通过 MQ 回传，不反向 Feign 调用 payment。数据库 mall_order</description>

    <dependencies>
        <dependency>
            <groupId>com.mallcloud</groupId>
            <artifactId>common-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mallcloud</groupId>
            <artifactId>common-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mallcloud</groupId>
            <artifactId>api-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mallcloud</groupId>
            <artifactId>api-order</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mallcloud</groupId>
            <artifactId>api-product</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mallcloud</groupId>
            <artifactId>api-ware</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mallcloud</groupId>
            <artifactId>api-cart</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mallcloud</groupId>
            <artifactId>api-coupon</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mallcloud</groupId>
            <artifactId>api-payment</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mallcloud</groupId>
            <artifactId>api-user</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.seata</groupId>
            <artifactId>seata-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>false</skip>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
